# ---------------------------------------------------------------------------
# Gather — backend environment
# Copy this to .env and fill in real values. NEVER commit .env.
# ---------------------------------------------------------------------------

# Runtime connection, used by the Express server and Prisma Client.
#   Local dev -> the Docker Postgres from docker-compose.yml
#   Deployed  -> Supabase POOLED connection (port 6543, ?pgbouncer=true)
DATABASE_URL="postgresql://username:password@localhost:5433/database-name?schema=public"

# Migrations-only connection, used by the Prisma CLI.
#   Local dev -> leave BLANK (falls back to DATABASE_URL)
#   Supabase  -> the DIRECT connection (port 5432). The pooled connection
#                cannot run DDL, so migrations fail against it.
DIRECT_URL=

# Signing key for session tokens. Must be at least 32 characters — the server
# refuses to start without it, so a deployment can't accidentally ship with a
# shared default key that would let anyone forge a login.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

PORT=3001

# Comma-separated list of browser origins allowed to call this API.
#   Local dev -> leave BLANK. Vite's dev server (http://localhost:5173) is
#                allowed automatically.
#   Deployed  -> the frontend's real URL. Nothing is allowed by default in
#                production, so an unset value here blocks every browser
#                request — the server prints a warning at boot saying so.
#
# `https://*.vercel.app` matches ONE subdomain level, which covers Vercel's
# per-branch preview URLs without allowing anything deeper.
#
# Example:
#   CORS_ORIGIN="https://gather-app.vercel.app,https://*.vercel.app"
CORS_ORIGIN=

# Set to "production" when deployed. This is what makes the CORS policy strict
# and what most hosts (Render, Railway, Fly) set for you automatically.
NODE_ENV=development
