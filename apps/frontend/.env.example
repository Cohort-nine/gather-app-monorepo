# ---------------------------------------------------------------------------
# Gather — frontend environment
# Copy this to .env and fill in real values. NEVER commit .env.
#
# Only variables prefixed with VITE_ are exposed to the browser bundle. That
# prefix is a safety feature, not a naming convention: anything named VITE_*
# ends up readable by anyone who opens devtools, so never put a secret here.
# The backend keeps the real secrets.
# ---------------------------------------------------------------------------

# Base URL of the Gather API, including the /api path.
#   Local dev  -> http://localhost:3001/api
#   Deployed   -> https://<your-render-service>.onrender.com/api
#
# Vite inlines this at BUILD time, so changing it on your host requires a
# redeploy, not just a restart.
VITE_API_URL=http://localhost:3001/api
